# Copy this file to .env and fill in your values

# Database (SQLite — no setup needed)
DATABASE_URL=sqlite:///./olibot.db

# Ollama (install from https://ollama.com, then: ollama pull llama3.1:8b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60

# JaCaMo BDI Agent (set JACAMO_ENABLED=true once JaCaMo is running)
JACAMO_BASE_URL=http://localhost:8080
JACAMO_ENABLED=false

# Safety Shield (strict=true means no direct answers ever)
SAFETY_SHIELD_STRICT=true
