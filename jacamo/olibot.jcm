/*
 * OLIBOT JaCaMo Project File
 *
 * Defines the Multi-Agent System structure:
 *   - Agent:       olibot (Jason BDI agent)
 *   - Environment: OlibotEnv (CArtAgO artifact exposing REST API to Python)
 */
mas olibot {

    agent olibot : olibot.asl {
        beliefs: zdp_threshold(0.6)
                 max_hint_level(3)
    }

    workspace olibot_workspace {
        artifact olibot_env : env.OlibotEnv(8080)
    }
}