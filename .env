# OLIBOT — Environment Configuration
# Copy this file to .env and adjust as needed.
# All variables are optional; the values below are the defaults.

# ── Application ───────────────────────────────────────────────────────
APP_NAME="OLIBOT API"
APP_VERSION="0.1.0"
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./olibot.db

# ── Ollama (Local LLM) ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60

# ── JaCaMo BDI Agent ──────────────────────────────────────────────────
# Set JACAMO_ENABLED=true when the JaCaMo agent is running.
# Keep false to use the PythonBDIFallback (default for development).
JACAMO_ENABLED=true
JACAMO_BASE_URL=http://localhost:8080

# ── Safety Shield ─────────────────────────────────────────────────────
SAFETY_SHIELD_STRICT=true

# ── Pedagogy ──────────────────────────────────────────────────────────
DEFAULT_STUDENT_AGE=5
ZDP_HINT_THRESHOLD=0.6